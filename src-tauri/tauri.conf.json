{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Naglfar Launcher",
  "version": "0.2.3",
  "identifier": "com.naglfar.launcher",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:5599",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Naglfar Launcher",
