      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3RDkyOEE4OUEwRjM2OQpSV1JwODZDSmlwSjlEVENGek1mME81NU9QektNZE9XNGNuYTVUWHFTNGpkVVdVTGhzalpQTnFsZQo=",
      "endpoints": [
        "https://github.com/ShizunaSH/naglfar-launcher/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
